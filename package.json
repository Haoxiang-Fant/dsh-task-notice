{
  "name": "dsh-task-notice",
  "version": "0.3.1",
  "description": "DeepSeek Harness 插件:代理任务完工通知(弹窗提示任务完成与本次 Token 消耗及金额)+ 按 API Key 的 Token 消耗统计(缓存输入/缓外输入/输出,1年/6个月/3个月/1个月/15天/1周/24小时/自定义时间范围查询)+ 价格编辑(独立页面:模型价格跨 Key 合并,默认按官方价计费,激活后可自定义;0.1/0.2 旧账目默认按低谷价计算金额;Token Plan 订阅按金额与订阅费判断回本;Credit 换算;峰谷计价)+ 使用分析(顶部导航:模型金额占比饼图、各 Key 消耗额度、Token Plan 回本与计费周期/重置、性价比计算、每日费用消耗表)。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./typert": {
      "default": "./lib/typert.host.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "dshhub": {
    "schemaVersion": 1,
    "displayName": "dsh-task-notice",
    "summary": "代理任务完工弹窗通知(含本次 Token 消耗与金额)、按 API Key 统计 Token 消耗(缓存输入/缓外输入/输出,支持 1年/6个月/3个月/1个月/15天/1周/24小时/自定义时间)、价格编辑(独立页面,模型价格跨 Key 合并,默认官方价,激活后自定义;旧账目按低谷价)、Token Plan 订阅回本判断与 Credit 换算、峰谷计价、使用分析(模型金额占比饼图/各 Key 额度/Token Plan 回本与计费周期重置/性价比/每日费用消耗表)。",
    "categories": [
      "通知",
      "消耗统计",
      "Web UI",
      "观测"
    ],
    "surfaces": [
      "host",
      "web"
    ],
    "capabilities": {
      "provides": [
        "service:task-notice"
      ]
    },
    "compatibility": {
      "dsh": ">=0.1.0-rc.5",
      "node": ">=20"
    },
    "permissions": {}
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "client-plugin",
    "notice",
    "notification",
    "token",
    "usage",
    "statistics",
    "消耗",
    "通知",
    "统计",
    "api-key"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "zod": "^4.4.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "zod": "^4.5.4"
  }
}
