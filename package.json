{
  "name": "dsh-task-notice",
  "version": "0.3.14",
  "description": "DeepSeek Harness 插件:任务完成/失败通知(含本次消耗与金额)+ 按 Key·模型的 Token 消耗统计 + 实时计价(改价即生效)+ Token Plan 回本/性价比与每日费用分析 + 工具箱小工具。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./typert": {
      "default": "./lib/typert.host.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "dshhub": {
    "schemaVersion": 1,
    "displayName": "dsh-task-notice",
    "summary": "0.3.14:Token Plan 支持连续订阅/过期感知/套餐更改/周期编辑器/订阅合并,性价比改为累计金额与累计 tokens;消耗饼图小额模型合并为其它并支持下钻,新增实际金额外圈与按次付费计价。功能:任务完成/失败通知、Token 消耗统计、实时计价、回本与性价比分析、每日费用表。",
    "categories": [
      "通知",
      "消耗统计",
      "Web UI",
      "观测"
    ],
    "surfaces": [
      "host",
      "web"
    ],
    "capabilities": {
      "provides": [
        "service:task-notice"
      ]
    },
    "compatibility": {
      "dsh": ">=0.1.0-rc.5",
      "node": ">=20"
    },
    "permissions": {}
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "client-plugin",
    "notice",
    "notification",
    "token",
    "usage",
    "statistics",
    "消耗",
    "通知",
    "统计",
    "api-key"
  ],
  "license": "MIT",
  "author": "范浩翔",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "zod": "^4.4.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "zod": "^4.5.4"
  }
}
