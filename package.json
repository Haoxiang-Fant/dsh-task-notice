{
  "name": "dsh-task-notice",
  "version": "0.3.13",
  "description": "DeepSeek Harness 插件:任务完成/失败通知(含本次消耗与金额)+ 按 Key·模型的 Token 消耗统计 + 实时计价(改价即生效)+ Token Plan 回本/性价比与每日费用分析 + 工具箱小工具。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./typert": {
      "default": "./lib/typert.host.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "dshhub": {
    "schemaVersion": 1,
    "displayName": "dsh-task-notice",
    "summary": "0.3.13:国际模型缓存写入计费修复、价格编辑去重与实时计价——周期只落盘窗口与订阅费,每次读取都按账本 × 当前价格现算,改价立即生效,不再复用旧金额;性价比 / 饼图 / 每日费用表一律按 (Key · 模型) 成条计算,不同 Key 的同名模型不再合并,图例颜色互不相同。功能:任务完成/失败通知(含消耗与金额)、按 Key·模型统计 Token 消耗、实时计价、Token Plan 回本与性价比分析、每日费用消耗表、工具箱小工具。",
    "categories": [
      "通知",
      "消耗统计",
      "Web UI",
      "观测"
    ],
    "surfaces": [
      "host",
      "web"
    ],
    "capabilities": {
      "provides": [
        "service:task-notice"
      ]
    },
    "compatibility": {
      "dsh": ">=0.1.0-rc.5",
      "node": ">=20"
    },
    "permissions": {}
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "client-plugin",
    "notice",
    "notification",
    "token",
    "usage",
    "statistics",
    "消耗",
    "通知",
    "统计",
    "api-key"
  ],
  "license": "MIT",
  "author": "范浩翔",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "zod": "^4.4.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "zod": "^4.5.4"
  }
}
